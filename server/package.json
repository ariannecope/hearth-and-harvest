{
  "name": "hearth-harvest-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "db:setup": "node --env-file-if-exists=.env db/setup.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "check-links": "node scripts/check-links.js",
    "images": "node scripts/fetch-images.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
